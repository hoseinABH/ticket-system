PORT=3000
DATABASE_URL=postgresql://root:secret@localhost:5432/ticket_system
REDIS_URL=redis://localhost:6379
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600
# Optional: set both to enable @nestjs/observe telemetry
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
